{
  "name": "our-basket",
  "main": "build/worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "our-basket", "database_id": "REPLACE_WITH_NEW_D1_ID", "migrations_dir": "migrations"}],
  "vars": {"ACCESS_ISSUER": "https://YOUR_TEAM.cloudflareaccess.com", "ACCESS_AUD": "REPLACE_WITH_ACCESS_APP_AUD", "MEMBER_EMAILS": "YOUR_VERIFIED_EMAIL,SECOND_VERIFIED_EMAIL"}
}
